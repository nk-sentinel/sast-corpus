# scan outputs and scorecards are run artifacts, never committed
results/
runs/
scorecards/
*.sarif
*.fpr

# ...except the captured real-tool output the adapter tests are built from.
# Those are fixtures, not artifacts: without them the adapter is back to being
# validated only against payloads we invented, and the tests silently cannot run
# anywhere but the machine that captured them.
!spine/tests/data/*.sarif

# python
__pycache__/
*.py[cod]
.venv/
venv/

# build artifacts from hermetic corpus builds
target/
build-out/
node_modules/
*.class
*.jar
!build/**/*.jar

# editor / os
.DS_Store
*.swp
.idea/
.vscode/

# Claude Code hook transcripts. Local tooling output, not corpus material.
/.hooks-lab/

# External corpora are fetched at pinned revisions, never vendored.
# spine/corpora/fetch.py <corpus> clones them.
/tier2/*/
/tier3/*/
/perf/*/

# Fixed-commit trap sources are upstream code, derived on demand; committing
# them would redistribute other projects licences along with ours.
/tier3/fixed-sources/

# tier-3 build toolchains and outputs, provisioned on demand
/tier3/cwe-bench-java/java-env/
/tier3/cwe-bench-java/build-info/
/tier3/cwe-bench-java/project-sources
tier3/patcheval/
tier3/reef/
